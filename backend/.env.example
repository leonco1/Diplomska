# Copy to .env and fill in your values

# Postgres
# Option A: Local Postgres via Homebrew (recommended for macOS)
#   brew install postgresql@14
#   brew services start postgresql@14
#   createdb streamapp
DB_HOST=localhost
DB_PORT=5432
DB_USER=<your-macOS-username>
DB_PASSWORD=
DB_NAME=streamapp

# Option B: Docker (use docker-compose.yml)
#   npm run db:up
#   Update these to match docker-compose.yml POSTGRES_PASSWORD

# OpenAI API key for the support chatbot (https://platform.openai.com/api-keys)
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# Server
PORT=3000
# Allowed CORS origin (the Vite frontend)
FRONTEND_ORIGIN="http://localhost:5173"

# Max upload size in bytes (default 500 MB)
MAX_UPLOAD_BYTES=524288000

# Keycloak (auth). Start via `npm run db:up` (docker-compose) — realm is auto-imported.
# Admin console: http://localhost:8080  (admin/admin). Seed users: admin/admin, user/user.
KEYCLOAK_ISSUER="http://localhost:8080/realms/streamapp"
KEYCLOAK_JWKS_URI="http://localhost:8080/realms/streamapp/protocol/openid-connect/certs"
# Keycloak access tokens are issued with aud "account" by default. Set to the
# value you actually see in a decoded token if validation 401s (or leave as-is).
KEYCLOAK_AUDIENCE="account"
